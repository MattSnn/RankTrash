# Copie para .env.local e preencha com os dados do seu projeto Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
# true = mostra o botão GALERIA no registro (só para testes)
VITE_ALLOW_GALLERY=false
# Mapa: padrão vetorial (OpenFreeMap, sem chave). Com VITE_MAP_TILE_URL, usa tiles raster.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap
# VITE_MAP_TILE_FILTER=dark   # dark | none (use none para tiles já escuros)
# true = roda sem backend, com dados e IA simulados (bom para apresentar/desenvolver a UI)
VITE_DEMO=false

# Copie para .env.local e preencha com os dados do seu projeto Supabase
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key
# Domínios de e-mail aceitos no login (separados por vírgula)
VITE_ALLOWED_EMAIL_DOMAINS=facens.br
# E-mails liberados fora dos domínios acima (separados por vírgula)
VITE_ALLOWED_EMAILS=
# true = roda sem backend, com dados e IA simulados (bom para apresentar/desenvolver a UI)
VITE_DEMO=false

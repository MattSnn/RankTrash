{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/(?!assets/|icons/|landing/).*",
      "has": [{ "type": "host", "value": "sobre.ranktrash.eco.br" }],
      "dest": "/landing.html"
    },
    { "handle": "filesystem" },
    { "src": "^/(?!assets/|icons/|landing/|sw\\.js|workbox-|manifest\\.webmanifest|registerSW\\.js).*", "dest": "/index.html" }
  ]
}
